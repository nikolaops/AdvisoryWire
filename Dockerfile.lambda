# Build stage
FROM public.ecr.aws/docker/library/node:20-alpine AS builder

WORKDIR /build

COPY package.json package-lock.json* ./
RUN npm install --ignore-scripts

COPY tsconfig.json tsconfig.lambda.json ./
COPY src/ ./src/

RUN npx tsc -p tsconfig.lambda.json

# Runtime stage — Lambda provided runtime
FROM public.ecr.aws/lambda/nodejs:20

WORKDIR ${LAMBDA_TASK_ROOT}

# Copy compiled JS
COPY --from=builder /build/dist/ ./dist/

# Copy production dependencies only
COPY --from=builder /build/package.json ./
COPY --from=builder /build/node_modules/ ./node_modules/

# Lambda handler entry point: file dist/lambda/handler.js, export named "handler"
CMD ["dist/lambda/handler.handler"]
