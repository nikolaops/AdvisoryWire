# Local development only — Lambda reads config from env vars set in Terraform,
# and secrets from AWS Secrets Manager (not this file).

NODE_ENV=development
LOG_LEVEL=debug

# Required for local runs (Lambda gets these from Secrets Manager)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C01234567890

# DynamoDB (Lambda uses the table name from DYNAMODB_TABLE env var)
DYNAMODB_TABLE=advisorywire
AWS_REGION=eu-west-1

# Optional — increases rate limits
GITHUB_TOKEN=
NVD_API_KEY=

# OSV ecosystems (comma-separated, defaults used if empty)
# OSV_ECOSYSTEMS=npm,PyPI,Go,NuGet,Packagist,Debian,Ubuntu,Alpine,Rocky Linux,AlmaLinux,GitHub Actions,VSCode

# NVD filter — CPE keyword matching (empty = no filter)
# NVD_ECOSYSTEMS=microsoft:windows,apple:macos,apple:mac_os_x

# Routing
INSTANT_ALERT_SEVERITIES=critical,high
INSTANT_ALERT_IF_EXPLOITED=true
DIGEST_SEVERITIES=medium,low
